# Real path on your host machine, mounted into the container as /music (see docker-compose.yml).
MUSIC_HOST_DIR=C:/Users/YourName/Music/Playlist

SYNC_INTERVAL=86400        # Seconds between each sync cycle.
DOWNLOAD_CONCURRENCY=2     # Max simultaneous downloads, shared across all playlists.
TEMP_DIR=/tmp/playlist2mp3 # Working directory for temp files during conversion.
LOG_LEVEL=info             # debug | info | warn | error
MAX_SIZE=                  # Max disk quota for the playlist directories, e.g. "500M" or "1G". Empty or "0" = unlimited.

RANDOM_PLAYLIST=false      # true to download a different random public playlist every cycle.
RANDOM_PLAYLIST_DIR=/music # Root directory for that random playlist. Only used when RANDOM_PLAYLIST=true.

# Each playlist needs its own NAME/URL/DIR block, numbered with the same index N.
# PLAYLIST_N_DIR/PLAYLIST_N_NAME/ is created automatically to hold the MP3s.
PLAYLIST_1_NAME=Rock
PLAYLIST_1_URL=https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M
PLAYLIST_1_DIR=/music

PLAYLIST_2_NAME=Electronic
PLAYLIST_2_URL=https://open.spotify.com/playlist/37i9dQZF1DX4dyzvuaRJ0n
PLAYLIST_2_DIR=/music
