# Carpeta REAL de tu ordenador o servidor donde se guardaran los MP3.
# Ejemplos: C:/Users/TuNombre/Music/Playlist (Windows) o /srv/music (Linux).
#
# Dentro del contenedor esa carpeta siempre se ve como /music: /music es una
# ruta interna del contenedor, NO de tu equipo. No hace falta escribir /music
# en ningun sitio; cada playlist se guarda en /music/<nombre de la playlist>.
#
# Todo lo demas se configura en config/config.json.
MUSIC_HOST_DIR=C:/Users/YourName/Music/Playlist
