{
  "name": "playlist2mp3",
  "version": "1.0.0",
  "description": "Headless Docker service that keeps local MP3 folders in sync with Spotify playlists (mirror or incremental).",
  "type": "module",
  "license": "MIT",
  "author": "Alejandro Propst",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/propstgonz/Playlist2MP3.git"
  },
  "bugs": {
    "url": "https://github.com/propstgonz/Playlist2MP3/issues"
  },
  "homepage": "https://github.com/propstgonz/Playlist2MP3#readme",
  "keywords": [
    "spotify",
    "mp3",
    "playlist",
    "docker",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check:match": "tsx scripts/check-match.ts",
    "test": "node --import tsx --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "node-id3": "^0.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
